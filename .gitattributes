* text=auto eol=lf
# Keep common binary assets untouched by Git text normalization.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.mp4 binary
*.mov binary
*.avi binary
*.mkv binary
*.mp3 binary
*.wav binary
*.pdf binary

# Git LFS — Vercel 배포 원본 (public/ 만 LFS, frontend/video 는 .gitignore)
# 가이드: md/PUBLIC_VIDEO_GIT_AND_DEPLOY.md
public/video/** filter=lfs diff=lfs merge=lfs -text
public/assets/videos/** filter=lfs diff=lfs merge=lfs -text
public/**/*.mov filter=lfs diff=lfs merge=lfs -text
public/**/*.webm filter=lfs diff=lfs merge=lfs -text
public/**/*.mkv filter=lfs diff=lfs merge=lfs -text

*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.py text eol=lf
*.sql text eol=lf
*.bat text eol=crlf
