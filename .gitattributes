* text=auto eol=lf
# Keep common binary assets untouched by Git text normalization.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.mp4 binary
*.mov binary
*.avi binary
*.mkv binary
*.mp3 binary
*.wav binary
*.pdf binary
# Git LFS — 대용량 영상 (전역 + public/ 명시)
# 가이드: md/PUBLIC_VIDEO_GIT_AND_DEPLOY.md
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
public/video/** filter=lfs diff=lfs merge=lfs -text
public/assets/videos/** filter=lfs diff=lfs merge=lfs -text
public/**/*.webm filter=lfs diff=lfs merge=lfs -text
public/**/*.mkv filter=lfs diff=lfs merge=lfs -text
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.py text eol=lf
*.sql text eol=lf
*.bat text eol=crlf
