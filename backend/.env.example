## API server (Uvicorn — frontend js/core/api.js 의 BOXER_API_PORT 와 맞출 것)
HOST=0.0.0.0
PORT=8000

## MySQL connection (required)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=boxer_db
DB_USER=root
DB_PASSWORD=CHANGE_ME

## Optional: direct SQLAlchemy URL (overrides DB_* when set)
# DATABASE_URL=mysql+aiomysql://root:CHANGE_ME@localhost:3306/boxer_db?charset=utf8mb4

## Optional: Gemini
# GEMINI_API_KEY=
