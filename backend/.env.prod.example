## ---------------------------
## Production example (.env.prod)
## ---------------------------
APP_NAME=Boxer API
APP_VERSION=4.0.0
DEBUG=False
HOST=0.0.0.0
PORT=8000

## DB: 운영에서는 localhost 대신 내부 네트워크 주소/서비스명 사용
DB_HOST=db
DB_PORT=3306
DB_NAME=boxer_db
DB_USER=boxer_app
DB_PASSWORD=CHANGE_ME_STRONG

## 운영에서는 명시 URL 권장 (앱 계정 사용)
DATABASE_URL=mysql+aiomysql://boxer_app:CHANGE_ME_STRONG@db:3306/boxer_db?charset=utf8mb4

## JWT
JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ADMIN_BOOTSTRAP_EMAIL=

## 운영 도메인만 허용
CORS_ORIGINS=["https://your-domain.com"]

## Optional API keys
GEMINI_API_KEY=
