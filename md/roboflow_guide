## 1. 환경 설정 및 구글 드라이브 연동
코랩 세션이 끊겨도 데이터가 사라지지 않도록 가장 먼저 수행해야 합니다.

```python
from google.colab import drive
drive.mount('/content/drive')

!pip install ultralytics roboflow


## Roboflow 데이터셋 학습 (안전 루트)- 구글 드라이브 내 특정 폴더에 학습 결과가 실시간 저장되도록 설정합니다.

from roboflow import Roboflow
from ultralytics import YOLO

# 1. 데이터셋 로드
rf = Roboflow(api_key="여기에_API키_입력")
project = rf.workspace("s-workspace-ipg6l").project("room-df62t-minjy")
dataset = project.version(1).download("yolov11")

# 2. 학습 시작 (드라이브 저장 설정)
model = YOLO('yolo11n.pt')
model.train(
    data=f"{dataset.location}/data.yaml",
    epochs=50,
    imgsz=640,
    project="/content/drive/MyDrive/BoxingAI",
    name="room_detection_run",
    exist_ok=True
)

# 3. 학습 중단 시 복구 방법 (Resume)
GPU 연결이 끊겼을 때 처음부터 다시 하지 않고 이어서 하는 방법입니다.

**1번(드라이브 마운트)**과 2번(Roboflow 로드) 셀을 다시 실행합니다.

아래 코드로 마지막 저장 지점(last.pt)부터 재개합니다.

from ultralytics import YOLO
model = YOLO('/content/drive/MyDrive/BoxingAI/room_detection_run/weights/last.pt')
model.train(resume=True)

# 4. 웹용 모델(TF.js) 변환 및 다운로드
# 1. 변환 실행
best_model = YOLO('/content/drive/MyDrive/BoxingAI/room_detection_run/weights/best.pt')
best_model.export(format='tfjs')

# 2. 압축 및 다운로드
import shutil
from google.colab import files
target = '/content/drive/MyDrive/BoxingAI/room_detection_run/weights/best_web_model'
shutil.make_archive('ai_model_final', 'zip', target)
files.download('ai_model_final.zip')

# 5. VS Code 프로젝트 배치 및 FastAPI 연동

my_project/
├── main.py (FastAPI 서버)
├── static/
│   └── best_web_model/  <-- 압축 푼 파일들 (model.json 등)
└── templates/
    └── index.html (프론트엔드)

#  FastAPI 설정 (main.py)
from fastapi import FastAPI
from fastapi.staticfiles import StaticFiles

app = FastAPI()
# static 폴더를 외부에 공개하여 모델 파일을 읽을 수 있게 함
app.mount("/static", StaticFiles(directory="static"), name="static")


# 프론트엔드 모델 로드 (JS)
// index.html <head> 부분에 추가
// <script src="[https://cdn.jsdelivr.net/npm/@tensorflow/tfjs](https://cdn.jsdelivr.net/npm/@tensorflow/tfjs)"></script>

async function loadAI() {
    // /static 경로를 통해 모델 로드
    const model = await tf.loadGraphModel('/static/best_web_model/model.json');
    console.log("AI Ready!");
}
